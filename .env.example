# Loaded by server.ts via dotenv (process env overrides this file).
# Server port (optional — default 3000)
PORT=3000

# Set to "production" for static dist serving; omit or use "development" for Vite HMR
NODE_ENV=development

# Honor X-Forwarded-For for rate limits / download caps.
# Enable only behind a trusted reverse proxy. Values: 1, true, yes
# Required on Render (set automatically by render.yaml).
# TRUST_PROXY=true